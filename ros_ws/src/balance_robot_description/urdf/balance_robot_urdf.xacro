<?xml version="1.0"?>

<robot name="balance_robot" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="use_actual_stl_assembly" default="false"/>
  <xacro:property name="stl_assembly_origin_xyz" value="-0.110383 -0.202 0.064314"/>
  <xacro:property name="stl_assembly_origin_rpy" value="0 0 0"/>
  <xacro:property name="stl_assembly_scale" value="0.001 0.001 0.001"/>

  <xacro:include filename="$(find robot_description)/urdf/color_properties.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/balance_robot_gazebo.xacro"/>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">	
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <xacro:if value="$(arg use_actual_stl_assembly)">
      <visual>
        <origin xyz="${stl_assembly_origin_xyz}" rpy="${stl_assembly_origin_rpy}"/>
        <geometry>
          <mesh filename="package://robot_description/stl/body_side.stl" scale="${stl_assembly_scale}"/>
        </geometry>
        <material name="light_black"/>
      </visual>

      <visual>
        <origin xyz="${stl_assembly_origin_xyz}" rpy="${stl_assembly_origin_rpy}"/>
        <geometry>
          <mesh filename="package://robot_description/stl/robot_neck.stl" scale="${stl_assembly_scale}"/>
        </geometry>
        <material name="dark"/>
      </visual>

      <visual>
        <origin xyz="${stl_assembly_origin_xyz}" rpy="${stl_assembly_origin_rpy}"/>
        <geometry>
          <mesh filename="package://robot_description/stl/head_rear.stl" scale="${stl_assembly_scale}"/>
        </geometry>
        <material name="light_black"/>
      </visual>

      <visual>
        <origin xyz="${stl_assembly_origin_xyz}" rpy="${stl_assembly_origin_rpy}"/>
        <geometry>
          <mesh filename="package://robot_description/stl/head_top.stl" scale="${stl_assembly_scale}"/>
        </geometry>
        <material name="dark"/>
      </visual>

      <visual>
        <origin xyz="${stl_assembly_origin_xyz}" rpy="${stl_assembly_origin_rpy}"/>
        <geometry>
          <mesh filename="package://robot_description/stl/gemini335_case.stl" scale="${stl_assembly_scale}"/>
        </geometry>
        <material name="grey"/>
      </visual>
    </xacro:if>

    <xacro:unless value="$(arg use_actual_stl_assembly)">
      <visual>
        <origin xyz="0.0 0.0 0.31" rpy="0 0 0"/>
        <geometry>
          <box size="0.15 0.35 0.45"/>
        </geometry>
        <material name="light_black"/>
      </visual>
    </xacro:unless>

    <collision>
      <origin xyz="0.0 0.0 0.31" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.35 0.45"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.31" rpy="0 0 0"/>
      <mass value="11.0"/>
      <inertia ixx="0.2979166" ixy="0.0" ixz="0.0"
               iyy="0.20625" iyz="0.0"
               izz="0.1329166" />
    </inertial>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0.0 0.215 0.085" rpy="1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.065" radius="0.085"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.065" radius="0.085"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="3" />
      <inertia ixx="0.0108375" ixy="0.0" ixz="0.0"
               iyy="0.006475" iyz="0.0"
               izz="0.006475" />
      </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0.0 -0.215 0.085" rpy="1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.065" radius="0.085"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.065" radius="0.085"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="3" />
      <inertia ixx="0.0108375" ixy="0.0" ixz="0.0"
               iyy="0.006475" iyz="0.0"
               izz="0.006475" />
      </inertial>
  </link>
  
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.535" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>

  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="0.0 0.0 0.565" rpy="0 0 0"/>
  </joint>

  <link name="base_scan">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_description/meshes/sensors/lds.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.0315" radius="0.055"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.114" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001" />
    </inertial>
  </link>
</robot>
